+        points = batch['inputs']['points'][0].cpu().numpy()
+
+        lidar_path = ''
+        try:
+            ds = batch['data_samples'][0]
+            lidar_path = ds.metainfo.get('lidar_path', '')
+        except (KeyError, IndexError, AttributeError):
